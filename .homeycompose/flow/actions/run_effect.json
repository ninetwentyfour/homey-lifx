{
  "id": "run_effect",
  "title": { "en": "Run LIFX effect" },
  "titleFormatted": { "en": "Run [[effect]] effect (period [[period_sec]] s)" },
  "hint": {
    "en": "Runs a firmware-driven LIFX effect on this bulb. Color Cycle / Random use Morph on matrix bulbs (Tube, Tile, Candle) and Breathe on regular bulbs. Flame and Move need matrix / multizone hardware respectively. Use the 'Stop LIFX effect' action to end it."
  },
  "args": [
    { "type": "device", "name": "device", "filter": "driver_id=bulb" },
    {
      "type": "dropdown",
      "name": "effect",
      "title": { "en": "Effect" },
      "values": [
        { "id": "color_cycle", "title": { "en": "Color Cycle (rainbow)" } },
        { "id": "random", "title": { "en": "Random Color" } },
        { "id": "breathe", "title": { "en": "Breathe (soft)" } },
        { "id": "pulse", "title": { "en": "Pulse (hard)" } },
        { "id": "morph", "title": { "en": "Morph (matrix)" } },
        { "id": "flame", "title": { "en": "Flame (matrix)" } },
        { "id": "move", "title": { "en": "Move (multizone)" } }
      ]
    },
    {
      "type": "number",
      "name": "period_sec",
      "title": { "en": "Period (s)" },
      "min": 0.1,
      "max": 60,
      "step": 0.1,
      "placeholder": "5"
    }
  ]
}
